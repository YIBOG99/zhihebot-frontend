# Public Supabase project URL (required for live backend features)
VITE_SUPABASE_URL=
# Public anon/publishable key only; never put service-role keys here
VITE_SUPABASE_ANON_KEY=
# Optional compatibility request ID; independent Supabase deployments can leave blank
VITE_ONEDAY_APP_ID=
VITE_SUPABASE_AUTH_STORAGE_KEY=
# true = render exported read-only snapshot; false = load public data from your own Supabase
VITE_PUBLIC_SNAPSHOT_MODE=true
